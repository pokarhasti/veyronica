# =============================================================================
# Veyronica — Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Database (Plan A: Docker, Plan B: Local, Plan C: Neon/Supabase) ---
DATABASE_URL=postgresql+asyncpg://veyronica:veyronica@localhost:5432/veyronica
DATABASE_URL_SYNC=postgresql://veyronica:veyronica@localhost:5432/veyronica

# --- Temporal (Plan A: local dev server, Plan B: Docker, Plan C: Cloud) ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=replenishment

# --- LLM (Primary: Gemini 8-Key Pool, Fallback: Grok, Plan C: Deterministic Template) ---
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Supported Gemini models:
# - gemini-3.8-flash (Gemini 3.8 Flash)
# - gemini-3.6-flash (Gemini 3.6 Flash)
# - gemini-3.5-flash-lite (Gemini 3.5 Flash-Lite)
# - gemma-4 (Gemma 4)

# Gemini 8-Key Pool (failover sequence if any key dies or exhausts quota)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

LLM_FALLBACK_PROVIDER=grok
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

LLM_TIMEOUT_SECONDS=20
LLM_RETRY_COUNT=2

# --- Policy Thresholds (single source of truth) ---
AUTO_APPROVE_LIMIT=10000
STORE_MANAGER_LIMIT=50000
REORDER_COVER_DAYS=6
TARGET_COVER_DAYS=14
LEAD_TIME_THRESHOLD_DAYS=7
PACK_SIZE=10

# --- Server ---
CORS_ORIGINS=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend (set in frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
